{
  "name": "tui-milkdown-vscode",
  "displayName": "TUI Markdown Editor",
  "description": "A beautiful WYSIWYG Markdown editor powered by Tiptap. Edit markdown files with rich text experience and theme selection.",
  "version": "2.15.2",
  "publisher": "tuanhv",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoangvantuan/tui-milkdown-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/hoangvantuan/tui-milkdown-vscode/issues"
  },
  "homepage": "https://github.com/hoangvantuan/tui-milkdown-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "tiptap",
    "editor",
    "rich text",
    "preview"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "TUI Markdown",
      "properties": {
        "tuiMarkdown.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 8,
          "maximum": 32,
          "description": "Font size for the Markdown editor (in pixels)"
        },
        "tuiMarkdown.headingSizes.h1": {
          "type": "number",
          "default": 32,
          "minimum": 12,
          "maximum": 72,
          "description": "Font size for H1 headings (in pixels)"
        },
        "tuiMarkdown.headingSizes.h2": {
          "type": "number",
          "default": 28,
          "minimum": 12,
          "maximum": 72,
          "description": "Font size for H2 headings (in pixels)"
        },
        "tuiMarkdown.headingSizes.h3": {
          "type": "number",
          "default": 24,
          "minimum": 12,
          "maximum": 72,
          "description": "Font size for H3 headings (in pixels)"
        },
        "tuiMarkdown.headingSizes.h4": {
          "type": "number",
          "default": 20,
          "minimum": 12,
          "maximum": 72,
          "description": "Font size for H4 headings (in pixels)"
        },
        "tuiMarkdown.headingSizes.h5": {
          "type": "number",
          "default": 18,
          "minimum": 12,
          "maximum": 72,
          "description": "Font size for H5 headings (in pixels)"
        },
        "tuiMarkdown.headingSizes.h6": {
          "type": "number",
          "default": 16,
          "minimum": 12,
          "maximum": 72,
          "description": "Font size for H6 headings (in pixels)"
        },
        "tuiMarkdown.highlightCurrentLine": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the line containing the cursor in the editor"
        },
        "tuiMarkdown.imageSaveFolder": {
          "type": "string",
          "default": "images",
          "description": "Folder to save pasted images (relative to document). Use '.' for same folder as document."
        },
        "tuiMarkdown.autoRenameImages": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rename image files when you change the image path in markdown (only when folder stays the same)"
        },
        "tuiMarkdown.autoDeleteImages": {
          "type": "boolean",
          "default": true,
          "description": "Automatically delete image files when removed from markdown (moves to trash)"
        },
        "tuiMarkdown.autoHideToolbar": {
          "type": "boolean",
          "default": false,
          "description": "Auto-hide toolbar when typing (show on hover)"
        },
        "tuiMarkdown.listIndent": {
          "type": [
            "string",
            "number"
          ],
          "enum": [
            "editor",
            2,
            4,
            "tab"
          ],
          "default": "editor",
          "description": "List indentation style: 'editor' to follow VS Code settings, or force 2, 4 spaces or 'tab'"
        },
        "tuiMarkdown.chromiumPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a Chrome/Chromium/Edge/Brave executable used for PDF export. Leave empty to auto-detect."
        },
        "tuiMarkdown.exportPageSize": {
          "type": "string",
          "enum": [
            "A4",
            "Letter"
          ],
          "default": "A4",
          "description": "Page size for PDF and DOCX export"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "tuiMarkdown.editor",
        "displayName": "TUI Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "{git,gitlens,git-graph}:/**/*.md": "default",
        "{git,gitlens,git-graph}:/**/*.markdown": "default"
      }
    },
    "commands": [
      {
        "command": "tuiMarkdown.viewSource",
        "title": "View Source",
        "icon": "$(code)"
      },
      {
        "command": "tuiMarkdown.viewRichText",
        "title": "View Rich Text (WYSIWYG)",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tuiMarkdown.viewSource",
          "when": "activeCustomEditorId == 'tuiMarkdown.editor'",
          "group": "navigation"
        },
        {
          "command": "tuiMarkdown.viewRichText",
          "when": "(resourceExtname == '.md' || resourceExtname == '.markdown') && activeCustomEditorId != 'tuiMarkdown.editor'",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "build:dev": "node esbuild.config.js --dev",
    "watch": "node esbuild.config.js --watch",
    "lint": "tsc --noEmit",
    "roundtrip": "node esbuild.harness.config.js && node out/harness/roundtrip.js",
    "roundtrip:update": "node esbuild.harness.config.js && node out/harness/roundtrip.js --update",
    "build:floor-tests": "node esbuild.harness.config.js --floor-tests",
    "verify:vscode-floor": "npm run build && npm run build:floor-tests && node harness/vscode-floor/run.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/vscode": "~1.85.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@m2d/html": "^1.1.11",
    "@m2d/image": "^1.4.1",
    "@m2d/list": "^0.0.9",
    "@m2d/table": "^0.1.1",
    "@mermaid-js/layout-elk": "^0.2.3",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-code-block-lowlight": "3.30.1",
    "@tiptap/extension-find-and-replace": "3.30.1",
    "@tiptap/extension-highlight": "3.30.1",
    "@tiptap/extension-image": "3.30.1",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/extension-list": "3.30.1",
    "@tiptap/extension-paragraph": "3.30.1",
    "@tiptap/extension-placeholder": "3.30.1",
    "@tiptap/extension-table": "3.30.1",
    "@tiptap/markdown": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "@tiptap/suggestion": "3.30.1",
    "fuzzysort": "4.0.2",
    "image-size": "^2.0.2",
    "js-yaml": "5.3.0",
    "lowlight": "^3.3.0",
    "mdast2docx": "^1.6.1",
    "mermaid": "^11.17.2",
    "puppeteer-core": "^24.43.1",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
