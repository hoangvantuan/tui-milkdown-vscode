# Source & build config
src/**
*.ts
tsconfig.json
esbuild.config.js
esbuild.harness.config.js

# Dependency-verification harness (dev-only, never shipped)
harness/**
out/harness/**

# Unit tests (dev-only, never shipped)
test/**
out/test/**

# Dependencies
node_modules/**
package-lock.json

# Git & CI
.git/**
.github/**
.gitignore
.gitnexus/**
.gitnexusignore

# AI/agent tools
.agent/**
.agents/**
.claude/**
.mcp.json
_bmad/**
_bmad-output/**
AGENTS.md
CLAUDE.md
skills-lock.json

# IDE
.vscode/**
.vscodeignore

# Docs & plans
docs/**
plans/**
# CONTEXT.md is the agent-facing glossary, not user documentation. 2.16 shipped
# it to the marketplace because this list only named docs/**.
CONTEXT.md

# The hand-check wizard and the answers it records. `.manual-checks.env` is in
# .gitignore, which vsce does NOT read once a .vscodeignore exists, so it was
# packaged: a published .vsix carried one machine's temp paths and one tester's
# free-text notes. Caught by packaging locally before the release, not by CI.
scripts/**
.manual-checks.env

# Build artifacts
*.vsix
.DS_Store
# Sourcemaps: production builds don't emit them, but stale `build:dev` output
# would otherwise ship (~44 MB, 30 MB of it the mermaid artifact)
out/**/*.map
